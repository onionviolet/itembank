+
+test("one-to-one matching clears a previous use of the same category", async t => {
+  const item = { id: "q1", type: "dnd", stem: "Match the invented items.",
+    rows: [{ id: 0, text: "Lantern" }, { id: 1, text: "Bell" }],
+    categories: ["Glow", "Chime"], assignment: "one-to-one",
+    response_schema: { type: "object" } };
+  const page = await boot(t, item, [complete]);
+  const rows = Array.from(page.document.querySelectorAll(".rowline"));
+  const byName = name => rows.find(row => row.querySelector(".rowtext").textContent === name);
+  const pick = (name, category) => Array.from(byName(name).querySelectorAll("button"))
+    .find(button => button.textContent === category);
+  pick("Lantern", "Glow").click();
+  pick("Bell", "Glow").click();
+  assert.equal(pick("Lantern", "Glow").getAttribute("aria-pressed"), "false");
+  assert.equal(pick("Bell", "Glow").getAttribute("aria-pressed"), "true");
+  assert.equal(page.button().disabled, true);
+  pick("Lantern", "Chime").click();
+  await page.submit();
+  assert.deepEqual(page.answers(), [{ "0": "Chime", "1": "Glow" }]);
+});
