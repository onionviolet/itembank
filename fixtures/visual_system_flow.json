      "slug": "patent",
      "canonical": "patent",
      "def": "Open and unobstructed. A patent airway is one air can move through. Unrelated to the legal sense of the word.",
      "aliases": []
    },
    {
      "slug": "acute",
      "canonical": "acute",
      "def": "Fast in onset, not necessarily severe. An acute problem started recently. A severe problem is a different axis.",
      "aliases": []
    },
    {
      "slug": "oropharynx",
      "canonical": "oropharynx",
      "def": "The part of the throat directly behind the mouth, between the soft palate and the top of the epiglottis.",
      "aliases": []
    },
    {
      "slug": "stridor",
      "canonical": "stridor",
      "def": "A high, harsh sound heard on breathing in, caused by narrowing of the upper airway.",
