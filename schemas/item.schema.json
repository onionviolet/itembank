{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itembank.local/schemas/item.schema.json",
  "title": "itembank served item",
  "description": "What runtime.public_item() returns: the shape a learner may see before answering. This shape never carries an answer key, a rationale, a model answer, or any objective field -- that boundary is what public_item exists to draw, and a consumer reading this contract cold should not look for one. The syllabus [OBJECTIVE:] reference and the one-sentence Educational Objective line moved into explain_payload() in plan 03.1-03 (C7). explain_payload (not published here) is the after-answering counterpart.",
  "x-itembank-version": 1,
  "type": "object",
  "required": ["schema_version", "id", "number", "type", "stem", "difficulty", "response_schema"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "description": "The positional Qn-derived id, for example 'q3'. Not the opaque [ID:] identity field -- that lives on the private question dict, never on the served item."
    },
    "number": {
      "type": "integer"
    },
    "type": {
      "type": "string",
      "enum": ["mc", "multi", "table", "dnd", "build", "short", "visual"]
    },
    "stem": {
      "type": "string"
    },
    "difficulty": {
      "type": "string"
    },
    "lesson_slug": {
      "type": "string",
      "description": "The slug of the LESSON heading this item's [LESSON-REF:] names, produced by model.lesson_slug() -- empty when the item carries no resolved lesson reference. Present so the quiz page can build the 'Read the lesson' link without re-slugifying."
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "response_schema": {
      "type": "object",
      "description": "Describes the shape a submitted answer must take. Its own inner shape varies by item type; see the mc/multi, table/dnd, build and short variants below."
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/mc_multi_item"
    },
    {
      "$ref": "#/$defs/table_dnd_item"
    },
    {
      "$ref": "#/$defs/build_item"
    },
    {
      "$ref": "#/$defs/short_item"
    },
    {
      "$ref": "#/$defs/visual_item"
    }
  ],
  "$defs": {
    "option": {
      "type": "object",
      "required": ["key", "text"],
      "properties": {
        "key": {
          "type": "string",
          "description": "A letter A-H"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "row": {
      "type": "object",
      "required": ["text", "id"],
      "properties": {
        "text": {
          "type": "string"
        },
        "id": {
          "type": "integer",
          "description": "The row's position in the served (possibly shuffled) list, not a stable identity"
        }
      }
    },
    "mc_multi_item": {
      "type": "object",
      "required": ["type", "options", "response_schema"],
      "properties": {
        "type": {
          "enum": ["mc", "multi"]
        },
        "options": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "response_schema": {
          "$ref": "#/$defs/mc_multi_response_schema"
        }
      }
    },
    "table_dnd_item": {
      "type": "object",
      "required": ["type", "rows", "categories", "response_schema"],
      "properties": {
        "type": {
          "enum": ["table", "dnd"]
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "categories": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "response_schema": {
          "$ref": "#/$defs/table_dnd_response_schema"
        }
      }
    },
    "build_item": {
      "type": "object",
      "required": ["type", "steps", "response_schema"],
      "properties": {
        "type": {
          "const": "build"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "response_schema": {
          "$ref": "#/$defs/build_response_schema"
        }
      }
    },
    "short_item": {
      "type": "object",
      "required": ["type", "response_schema"],
      "properties": {
        "type": {
          "const": "short"
        },
        "response_schema": {
          "$ref": "#/$defs/short_response_schema"
        }
      }
    },
    "visual_item": {
      "type": "object",
      "required": ["type", "interaction_contract", "response_schema"],
      "properties": {
        "type": {
          "const": "visual"
        },
        "interaction_contract": {
          "$ref": "#/$defs/visual_interaction_contract"
        },
        "response_schema": {
          "type": "object",
          "description": "The visual response grammar; its inner shape is the interaction_contract's response_schema (plan 06.1-01)."
        }
      }
    },
    "visual_interaction_contract": {
      "type": "object",
      "description": "The key-free public visual contract (plan 06.1-01, D-03): version, type, interaction, renderer_config (scene/initial/actions/accessibility) and response_schema. It deliberately cannot carry accepted states, tolerance, partial_credit, or any scoring/reveal material -- those live only in the private SCORING envelope on the server item.",
      "additionalProperties": false,
      "required": ["version", "type", "interaction", "renderer_config", "response_schema"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "visual"
        },
        "interaction": {
          "type": "string",
          "enum": ["plot", "numberline", "hotspot", "timeline",
                    "diagram", "trace"]
        },
        "renderer_config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actions", "accessibility"],
          "properties": {
            "axes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": {
                  "$ref": "#/$defs/visual_axis"
                },
                "y": {
                  "$ref": "#/$defs/visual_axis"
                }
              }
            },
            "axis": {
              "$ref": "#/$defs/visual_axis"
            },
            "plane": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height"],
              "properties": {
                "width": {"type": "string"},
                "height": {"type": "string"}
              }
            },
            "regions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "shape", "coords"],
                "properties": {
                  "id": {"type": "string"},
                  "label": {"type": "string"},
                  "shape": {"type": "string",
                             "enum": ["rect", "circle", "polygon"]},
                  "coords": {"type": "array"}
                }
              }
            },
            "events": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label"],
                "properties": {
                  "id": {"type": "string"},
                  "label": {"type": "string"}
                }
              }
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "x", "y"],
                "properties": {
                  "id": {"type": "string"},
                  "label": {"type": "string"},
                  "x": {"type": "string"},
                  "y": {"type": "string"}
                }
              }
            },
            "point_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "initial": {
              "type": "object"
            },
            "actions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": ["place_point", "move_point",
                         "select_numberline_point", "set_interval",
                         "select_hotspot", "place_timeline_event",
                         "move_timeline_event", "connect_diagram",
                         "place_trace_point", "move_trace_point"]
              }
            },
            "accessibility": {
              "type": "object",
              "additionalProperties": false,
              "required": ["description"],
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "response_schema": {
          "type": "object",
          "required": ["type", "kind"],
          "properties": {
            "type": {
              "const": "object"
            },
            "kind": {
              "type": "string",
              "enum": ["point", "numberline_point", "interval",
                       "hotspot", "timeline_event", "diagram_connection",
                       "trace_path"]
            },
            "fields": {
              "type": "object"
            }
          }
        }
      }
    },
    "visual_axis": {
      "type": "object",
      "description": "One declarative axis: SCALAR min/max/step. The exact SCALAR grammar and the 201-tick cap are enforced by model lint and runtime canonicalization; this schema pins the shape and refuses extra members.",
      "additionalProperties": false,
      "required": ["min", "max", "step"],
      "properties": {
        "min": {
          "type": "string"
        },
        "max": {
          "type": "string"
        },
        "step": {
          "type": "string"
        },
        "ticks": {
          "type": "integer",
          "description": "Derived by the runtime: how many tick positions the axis holds (at most 201). Not authored, never scoring material -- informational for the renderer."
        }
      }
    },
    "mc_multi_response_schema": {
      "type": "object",
      "required": ["type", "select", "allowed"],
      "properties": {
        "type": {
          "enum": ["array", "string"],
          "description": "'string' for mc (pick one), 'array' for multi (pick select)"
        },
        "select": {
          "type": "integer"
        },
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The option keys a response may name"
        }
      }
    },
    "table_dnd_response_schema": {
      "type": "object",
      "required": ["type", "keys", "values"],
      "properties": {
        "type": {
          "const": "object"
        },
        "keys": {
          "const": "row id",
          "description": "Literal descriptive text: a response is keyed by row id"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The category names a row may be assigned to"
        }
      }
    },
    "build_response_schema": {
      "type": "object",
      "required": ["type", "items", "ordered"],
      "properties": {
        "type": {
          "const": "array"
        },
        "items": {
          "const": "step text",
          "description": "Literal descriptive text: a response is an array of step text"
        },
        "ordered": {
          "const": true
        }
      }
    },
    "short_response_schema": {
      "type": "object",
      "required": ["type", "min_length"],
      "properties": {
        "type": {
          "const": "string"
        },
        "min_length": {
          "type": "integer"
        }
      }
    }
  }
}
