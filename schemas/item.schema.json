{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itembank.local/schemas/item.schema.json",
  "title": "itembank served item",
  "description": "What runtime.public_item() returns: the shape a learner may see before answering. This shape never carries an answer key, a rationale, a model answer, or any objective field -- that boundary is what public_item exists to draw, and a consumer reading this contract cold should not look for one. The syllabus [OBJECTIVE:] reference and the one-sentence Educational Objective line moved into explain_payload() in plan 03.1-03 (C7). explain_payload (not published here) is the after-answering counterpart.",
  "x-itembank-version": 1,
  "type": "object",
  "required": ["schema_version", "id", "number", "type", "stem", "difficulty", "response_schema"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "description": "The positional Qn-derived id, for example 'q3'. Not the opaque [ID:] identity field -- that lives on the private question dict, never on the served item."
    },
    "number": {
      "type": "integer"
    },
    "type": {
      "type": "string",
      "enum": ["mc", "multi", "table", "dnd", "build", "short", "check"]
    },
    "stem": {
      "type": "string"
    },
    "difficulty": {
      "type": "string"
    },
    "lesson_slug": {
      "type": "string",
      "description": "The slug of the LESSON heading this item's [LESSON-REF:] names, produced by model.lesson_slug() -- empty when the item carries no resolved lesson reference. Present so the quiz page can build the 'Read the lesson' link without re-slugifying."
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "response_schema": {
      "type": "object",
      "description": "Describes the shape a submitted answer must take. Its own inner shape varies by item type; see the mc/multi, table/dnd, build and short variants below."
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/mc_multi_item"
    },
    {
      "$ref": "#/$defs/table_dnd_item"
    },
    {
      "$ref": "#/$defs/build_item"
    },
    {
      "$ref": "#/$defs/short_item"
    },
    {
      "$ref": "#/$defs/check_item"
    }
  ],
  "$defs": {
    "option": {
      "type": "object",
      "required": ["key", "text"],
      "properties": {
        "key": {
          "type": "string",
          "description": "A letter A-H"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "row": {
      "type": "object",
      "required": ["text", "id"],
      "properties": {
        "text": {
          "type": "string"
        },
        "id": {
          "type": "integer",
          "description": "The row's position in the served (possibly shuffled) list, not a stable identity"
        }
      }
    },
    "mc_multi_item": {
      "type": "object",
      "required": ["type", "options", "response_schema"],
      "properties": {
        "type": {
          "enum": ["mc", "multi"]
        },
        "options": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "response_schema": {
          "$ref": "#/$defs/mc_multi_response_schema"
        }
      }
    },
    "table_dnd_item": {
      "type": "object",
      "required": ["type", "rows", "categories", "response_schema"],
      "properties": {
        "type": {
          "enum": ["table", "dnd"]
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "categories": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "response_schema": {
          "$ref": "#/$defs/table_dnd_response_schema"
        }
      }
    },
    "build_item": {
      "type": "object",
      "required": ["type", "steps", "response_schema"],
      "properties": {
        "type": {
          "const": "build"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "response_schema": {
          "$ref": "#/$defs/build_response_schema"
        }
      }
    },
    "short_item": {
      "type": "object",
      "required": ["type", "response_schema"],
      "properties": {
        "type": {
          "const": "short"
        },
        "response_schema": {
          "$ref": "#/$defs/short_response_schema"
        }
      }
    },
    "check_item": {
      "type": "object",
      "required": ["type", "interaction_contract", "response_schema"],
      "description": "The served shape of a [TYPE: check] item (plan 05-01/05-07). It deliberately carries NO cases, NO expected text and NO key -- those are key material under D-12 and never reach the learner before answering. What a consumer may read cold is the versioned renderer-independent interaction envelope: a declarative renderer configuration (language, starter source, hidden-case count only), the raw-source response schema, and the top-level response_schema alias.",
      "properties": {
        "type": {
          "const": "check"
        },
        "interaction_contract": {
          "$ref": "#/$defs/interaction_contract"
        },
        "response_schema": {
          "$ref": "#/$defs/check_response_schema"
        }
      }
    },
    "interaction_contract": {
      "type": "object",
      "required": ["version", "type", "renderer_config", "response_schema"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "check"
        },
        "renderer_config": {
          "$ref": "#/$defs/check_renderer_config"
        },
        "response_schema": {
          "$ref": "#/$defs/check_response_schema"
        }
      }
    },
    "check_renderer_config": {
      "type": "object",
      "required": ["language", "starter_source", "hidden_case_count"],
      "additionalProperties": false,
      "description": "Declarative JSON data only -- language, optional starter source text, and the hidden-case count. additionalProperties: false rejects a bank smuggling authored JavaScript or any other executable payload through a permissive object.",
      "properties": {
        "language": {
          "type": "string"
        },
        "starter_source": {
          "type": "string"
        },
        "hidden_case_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "check_response_schema": {
      "type": "object",
      "required": ["type", "format", "language"],
      "properties": {
        "type": {
          "const": "string"
        },
        "format": {
          "const": "source"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "interaction_result": {
      "type": "object",
      "required": ["version", "type", "response", "verdict", "observations"],
      "description": "The normalized post-submit result (plan 05-01/05-07). The verdict is the exact boolean returned by the sole grader runtime.score_response() -- or null for a run the deadline killed (criterion 12, matching how response.schema.json allows score: null for a check response). The ordered observations are stable data for feedback, never a second scoring path.",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "check"
        },
        "response": {
          "type": "string"
        },
        "verdict": {
          "type": ["boolean", "null"]
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case_observation"
          }
        }
      }
    },
    "case_observation": {
      "type": "object",
      "required": ["case_index", "passed", "reason", "actual", "expected", "expected_kind", "input"],
      "properties": {
        "case_index": {
          "type": "integer",
          "minimum": 1
        },
        "passed": {
          "type": "boolean"
        },
        "reason": {
          "enum": ["passed", "wrong_output", "timeout", "output_cap"]
        },
        "actual": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "expected_kind": {
          "enum": ["output", "pattern"]
        },
        "input": {
          "type": "string"
        }
      }
    },
    "mc_multi_response_schema": {
      "type": "object",
      "required": ["type", "select", "allowed"],
      "properties": {
        "type": {
          "enum": ["array", "string"],
          "description": "'string' for mc (pick one), 'array' for multi (pick select)"
        },
        "select": {
          "type": "integer"
        },
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The option keys a response may name"
        }
      }
    },
    "table_dnd_response_schema": {
      "type": "object",
      "required": ["type", "keys", "values"],
      "properties": {
        "type": {
          "const": "object"
        },
        "keys": {
          "const": "row id",
          "description": "Literal descriptive text: a response is keyed by row id"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The category names a row may be assigned to"
        }
      }
    },
    "build_response_schema": {
      "type": "object",
      "required": ["type", "items", "ordered"],
      "properties": {
        "type": {
          "const": "array"
        },
        "items": {
          "const": "step text",
          "description": "Literal descriptive text: a response is an array of step text"
        },
        "ordered": {
          "const": true
        }
      }
    },
    "short_response_schema": {
      "type": "object",
      "required": ["type", "min_length"],
      "properties": {
        "type": {
          "const": "string"
        },
        "min_length": {
          "type": "integer"
        }
      }
    }
  }
}
