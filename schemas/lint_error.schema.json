{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itembank.local/schemas/lint_error.schema.json",
  "title": "itembank lint entry",
  "description": "One machine-readable finding from model.lint(), as returned by 'itembank lint --json' and by model.LintError._asdict(). The code enum is a published API namespace (D-16): adding a code here is additive, renaming or removing one is a breaking change for every authoring agent that branches on it.",
  "x-itembank-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "field",
    "item",
    "message"
  ],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "bank.answer_position_skew",
        "item.check_lang_unknown",
        "item.check_too_few_cases",
        "item.content_drift",
        "item.correct_unknown_option",
        "item.distractor_missing",
        "item.distractor_no_would_be",
        "item.duplicate_id",
        "item.duplicate_number",
        "item.duplicate_stem",
        "item.duplicate_steps",
        "item.lesson_ref_unknown",
        "item.low_confidence",
        "item.missing_distractor_notes",
        "item.missing_hash",
        "item.missing_id",
        "item.missing_model",
        "item.missing_second_best",
        "item.missing_trap",
        "item.missing_why_best",
        "item.model_too_long",
        "item.no_normalizer",
        "item.objective_line_multi_sentence",
        "item.objective_unnamespaced",
        "item.pair_singleton",
        "item.prereq_unknown",
        "item.row_category_unknown",
        "item.rubric_point_too_long",
        "item.select_mismatch",
        "item.tolerance_unstated",
        "item.too_few_categories",
        "item.too_few_options",
        "item.too_few_rows",
        "item.too_few_rubric_points",
        "item.too_few_steps",
        "item.visual_duplicate_id",
        "item.visual_empty_accessibility",
        "item.visual_executable_member",
        "item.visual_invalid_axis",
        "item.visual_invalid_geometry",
        "item.visual_invalid_scalar",
        "item.visual_invalid_scoring_kind",
        "item.visual_invalid_tolerance",
        "item.visual_json_malformed",
        "item.visual_unknown_action",
        "item.visual_unknown_interaction",
        "item.visual_unknown_member",
        "item.visual_unknown_scoring_kind",
        "key.duplicate_id",
        "key.in_rationale",
        "key.missing_hash",
        "key.missing_id",
        "key.no_front",
        "lesson.duplicate_heading",
        "lesson.orphan_heading",
        "lesson.src_unreadable",
        "lesson.invalid_gate",
        "lesson.check_ref_unknown",
        "prov.case_unknown",
        "prov.obj_unknown",
        "prov.paraphrase_copy",
        "prov.paraphrase_overlap",
        "prov.prereq_cycle",
        "prov.prereq_unknown",
        "prov.src_duplicate",
        "prov.src_unknown",
        "style.banned_hector",
        "style.duplicate_id",
        "style.file_unreadable",
        "style.filler_phrase",
        "style.forbidden_marker",
        "style.forbidden_phrase",
        "style.heading_cadence",
        "style.ignore_locked",
        "style.open_with",
        "style.order_before",
        "style.override_locked",
        "style.parameter_out_of_range",
        "style.parent_unknown",
        "style.require_marker",
        "style.rule_unimplemented",
        "style.section_density",
        "style.sentence_length",
        "style.unknown_parameter",
        "style.unsourced_specific",
        "terms.duplicate_slug",
        "terms.empty_block",
        "terms.unknown_ref"
      ]
    },
    "field": {
      "type": "string",
      "description": "The question dict key at fault, for example 'opts' or 'why'"
    },
    "item": {
      "type": "string",
      "description": "The item tag this finding is about, for example 'Q3', or the literal 'BANK' for a bank-wide finding"
    },
    "message": {
      "type": "string",
      "description": "The human-readable text; str(LintError(...)) reproduces '<item>: <message>' exactly"
    }
  }
}
