{
  "theme": "system",
  "accent": {
    "source": "#0e6e62"
  },
  "daily_cap": 40,
  "selection_weights": {
    "objective_miss_rate": 0.5,
    "difficulty_spread": 0.3,
    "recency_decay": 0.2
  },
  "auditor_autonomy": "report_only",
  "model_backend": {
    "active": "",
    "profiles": []
  },
  "suggestion_reveal": "after-self-mark",
  "update_policy": "check_on_launch",
  "daemon": {
    "port": 8730,
    "lan": false,
    "open_browser": true,
    "window": "app"
  },
  "reader": {
    "reader_nav": "none",
    "example_layout": "stacked",
    "print_gloss": "appendix",
    "gloss_marks": "all"
  },
  "update": {
    "repo": "onionviolet/itembank",
    "check_interval_hours": 24
  },
  "style": {
    "imperative_cap": 7,
    "warn_fp_threshold": 0.2
  },
  "paraphrase": {
    "winnow_threshold": 8,
    "jaccard_threshold": 0.25
  },
  "selection": {
    "cooldown_responses": 20
  },
  "subject_profiles": {
    "version": 1,
    "entries": {
      "emt": {
        "id": "emt",
        "version": 1,
        "lesson": {"markdown": true, "tables": true, "math": false,
                   "runnable_languages": [], "lesson_layout": "separate"},
        "allowed_item_types": ["mc", "multi", "table", "dnd", "build", "short"],
        "verifier": "runtime"
      },
      "math": {
        "id": "math",
        "version": 1,
        "lesson": {"markdown": true, "tables": true, "math": true,
                   "runnable_languages": [], "lesson_layout": "separate"},
        "allowed_item_types": ["mc", "multi", "table", "dnd", "build", "short"],
        "verifier": "runtime"
      },
      "cs": {
        "id": "cs",
        "version": 1,
        "lesson": {"markdown": true, "tables": true, "math": false,
                   "runnable_languages": ["python"], "lesson_layout": "inline"},
        "allowed_item_types": ["check", "mc", "multi", "table", "dnd", "build", "short"],
        "verifier": "check"
      }
    }
  }
}
